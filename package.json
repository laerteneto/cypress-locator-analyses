{
  "name": "cypress-locator-analyses",
  "version": "0.1.1",
  "description": "Cypress plugin and linter that grades selector fragility (A–F) and ranks the tests most likely to break.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cypress-locator-analyses": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "cypress",
    "cypress-plugin",
    "locator",
    "selector",
    "flaky",
    "lint",
    "test-automation",
    "e2e",
    "data-cy",
    "testing-library",
    "xpath",
    "css-selector",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "example": "pnpm run build && node dist/cli.js example/cypress/e2e --json example/fragility-report.json --html example/fragility-report.html",
    "typecheck": "pnpm run build && tsc -p tsconfig.check.json && tsc -p example/tsconfig.json && tsc -p e2e/tsconfig.json",
    "pretest": "pnpm run build",
    "e2e": "pnpm run build && cypress run --project e2e",
    "e2e:verify": "node scripts/verify-e2e-report.mjs e2e/fragility-report.json",
    "docs:images": "pnpm run build && node scripts/screenshots.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "cypress": ">=10"
  },
  "peerDependenciesMeta": {
    "cypress": {
      "optional": true
    }
  },
  "author": "Laerte Mello",
  "homepage": "https://github.com/laerteneto/cypress-locator-analyses#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laerteneto/cypress-locator-analyses.git"
  },
  "bugs": {
    "url": "https://github.com/laerteneto/cypress-locator-analyses/issues"
  },
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@testing-library/cypress": "^10.1.3",
    "@types/node": "^26.6.6",
    "cypress": "^16.2.1",
    "playwright-core": "^1.64.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  }
}
